  "coding": {
    "simulationOnly": true,
    "language": "typescript",
    "scenarios": [
      {
        "id": "quantity-variance",
        "title": "把数量差异算成了比值",
        "topic": "三单匹配 · 算术与边界",
        "bug": "数量差异应等于发票数量减去收货数量；当前函数错误地返回了两者的比值。",
        "targetFile": "src/erp/invoices/quantityVariance.ts",
        "beforeCode": "export function getQuantityVariance(receivedQty: number, invoicedQty: number): number {\n  return invoicedQty / receivedQty;\n}",
        "afterCode": "export function getQuantityVariance(receivedQty: number, invoicedQty: number): number {\n  return invoicedQty - receivedQty;\n}",
        "prompts": {
          "weak": "帮我修一下发票计算。",
          "specific": "检查 src/erp/invoices/quantityVariance.ts 中的 getQuantityVariance。数量差异定义为 invoicedQty - receivedQty；正数代表发票多开，负数代表少开。修正运算符，保持函数签名不变。",
          "testAware": "修正 getQuantityVariance，使结果等于 invoicedQty - receivedQty。先用 receivedQty=98、invoicedQty=100 的测试复现错误，再补充数量相等和发票少开两种测试。保持输入参数顺序和函数签名不变，解释修复前后差异。"
        },
        "explanation": "差值的单位是“件”，比值没有数量单位。用减法后，98 件收货、100 件开票会得到 +2 件；数量一致得到 0；少开票得到负数。",
        "scopeNote": "演示假设输入是已校验的非负整数；输入校验不在本次修改范围内。",
        "tests": [
          {
            "id": "quantity-over",
            "label": "多开 2 件",
            "input": {
              "receivedQty": 98,
              "invoicedQty": 100
            },
            "expected": 2,
            "beforeResult": 1.0204081632653061,
            "afterResult": 2,
            "beforePass": false,
            "afterPass": true,
            "booleanChange": {
              "from": false,
              "to": true
            }
          },
          {
            "id": "quantity-equal",
            "label": "数量一致",
            "input": {
              "receivedQty": 10,
              "invoicedQty": 10
            },
            "expected": 0,
            "beforeResult": 1,
            "afterResult": 0,
            "beforePass": false,
            "afterPass": true,
            "booleanChange": {
              "from": false,
              "to": true
            }
          },
          {
            "id": "quantity-under",
            "label": "少开 2 件",
            "input": {
              "receivedQty": 10,
              "invoicedQty": 8
            },
            "expected": -2,
            "beforeResult": 0.8,
            "afterResult": -2,
            "beforePass": false,
            "afterPass": true,
            "booleanChange": {
              "from": false,
              "to": true
            }
          }
        ],
        "expectedBooleanChanges": [
          {
            "testId": "quantity-over",
            "before": false,
            "after": true
          },
          {
            "testId": "quantity-equal",
            "before": false,
            "after": true
          },
          {
            "testId": "quantity-under",
            "before": false,
            "after": true
          }
        ],
        "takeaway": "提示词给出业务公式、参数含义和可验证的例子，比“修一下”更容易得到正确修改。"
      },
      {
        "id": "unsupported-currency",
        "title": "不支持的币种被直接入账",
        "topic": "总账 · 明确失败",
        "bug": "系统尚未实现汇率换算，却直接返回外币金额，导致调用方把外币数值当作账本币金额。",
        "targetFile": "src/erp/ledger/toLedgerAmount.ts",
        "beforeCode": "export function toLedgerAmount(\n  amount: number,\n  invoiceCurrency: string,\n  ledgerCurrency: string\n): number {\n  return amount;\n}",
        "afterCode": "export function toLedgerAmount(\n  amount: number,\n  invoiceCurrency: string,\n  ledgerCurrency: string\n): number {\n  if (invoiceCurrency !== ledgerCurrency) {\n    throw new Error(\"UNSUPPORTED_CURRENCY\");\n  }\n  return amount;\n}",
        "prompts": {
          "weak": "让这个函数支持多币种。",
          "specific": "修复 src/erp/ledger/toLedgerAmount.ts。当前版本没有汇率服务，只允许 invoiceCurrency 与 ledgerCurrency 相同；不同则抛出 Error(\"UNSUPPORTED_CURRENCY\")。不要猜测汇率，保留同币种返回金额的行为。",
          "testAware": "修复 toLedgerAmount：同币种正常返回金额；不同币种必须抛出 Error(\"UNSUPPORTED_CURRENCY\")，即使金额为 0。验证 CNY→CNY 100 返回 100、USD→CNY 100 抛错、USD→CNY 0 也抛错。保持函数签名不变。"
        },
        "explanation": "币种不一致时静默返回数值会产生错误账务。没有汇率能力的版本应明确拒绝跨币种入账，调用方才能阻止后续记账并提示人工处理。",
        "scopeNote": "演示使用已经规范化的大写币种代码；不接入汇率服务，也不模拟换汇。",
        "tests": [
          {
            "id": "currency-same",
            "label": "同币种保留金额",
            "input": {
              "amount": 100,
              "invoiceCurrency": "CNY",
              "ledgerCurrency": "CNY"
            },
            "expected": {
              "returns": 100
            },
            "beforeResult": {
              "returns": 100
            },
            "afterResult": {
              "returns": 100
            },
            "beforePass": true,
            "afterPass": true,
            "booleanChange": {
              "from": true,
              "to": true
            }
          },
          {
            "id": "currency-foreign",
            "label": "跨币种必须失败",
            "input": {
              "amount": 100,
              "invoiceCurrency": "USD",
              "ledgerCurrency": "CNY"
            },
            "expected": {
              "throws": "UNSUPPORTED_CURRENCY"
            },
            "beforeResult": {
              "returns": 100
            },
            "afterResult": {
              "throws": "UNSUPPORTED_CURRENCY"
            },
            "beforePass": false,
            "afterPass": true,
            "booleanChange": {
              "from": false,
              "to": true
            }
          },
          {
            "id": "currency-zero",
            "label": "零金额也校验币种",
            "input": {
              "amount": 0,
              "invoiceCurrency": "USD",
              "ledgerCurrency": "CNY"
            },
            "expected": {
              "throws": "UNSUPPORTED_CURRENCY"
            },
            "beforeResult": {
              "returns": 0
            },
            "afterResult": {
              "throws": "UNSUPPORTED_CURRENCY"
            },
            "beforePass": false,
            "afterPass": true,
            "booleanChange": {
              "from": false,
              "to": true
            }
          }
        ],
        "expectedBooleanChanges": [
          {
            "testId": "currency-same",
            "before": true,
            "after": true
          },
          {
            "testId": "currency-foreign",
            "before": false,
            "after": true
          },
          {
            "testId": "currency-zero",
            "before": false,
            "after": true
          }
        ],
        "takeaway": "说明系统尚不具备的能力，并指定失败方式，能避免助手擅自补上未经设计的业务行为。"
      },
      {
        "id": "tenant-filter",
        "title": "订单列表遗漏租户过滤",
        "topic": "多租户 · 数据隔离",
        "bug": "列表函数忽略了当前租户 ID，返回了输入中的全部订单。",
